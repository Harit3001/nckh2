FROM oven/bun:latest AS deps
WORKDIR /app

COPY bun.lock .
COPY server/package.json server/
COPY shared/package.json shared/
COPY contracts/package.json contracts/

RUN printf '{"name":"bhvr-server","private":true,"workspaces":["./server","./shared","./contracts"]}' > package.json
RUN bun install --ignore-scripts

COPY . .

FROM oven/bun:latest AS runtime
WORKDIR /app/server
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/server /app/server
COPY --from=deps /app/shared /app/shared
COPY --from=deps /app/contracts /app/contracts

EXPOSE 3000
CMD ["bun", "src/index.ts"]
