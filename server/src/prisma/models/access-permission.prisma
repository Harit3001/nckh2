model AccessPermission {
  id          Int    @id @default(autoincrement())
  patientId   Int    @map("patient_id")
  granteeId   Int    @map("grantee_id")
  granteeType String @map("grantee_type") @db.VarChar(30)

  recordScope String @map("record_scope")

  expiresAt DateTime? @map("expires_at")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")

  txHash String? @unique @map("tx_hash") @db.VarChar(100)

  status String @db.VarChar(30)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdBy Int? @map("created_by")
  updatedBy Int? @map("updated_by")
  deletedBy Int? @map("deleted_by")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([granteeId])
  @@index([granteeType])
  @@index([status])
  @@index([expiresAt])
  @@index([patientId, status])
  @@index([granteeId, status])
  @@index([patientId, granteeId])
  @@map("access_permissions")
}
